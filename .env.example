# Copy to .env. Defaults run offline: every provider is a deterministic fake.

# fake (offline, deterministic, fault injection for tests) | live (real providers)
GW_PROVIDER_MODE=fake

# Database. Empty means SQLite in .gw/. Docker compose uses Postgres:
# GW_DATABASE_URL=postgresql+psycopg://gw:gw@localhost:5435/gw
GW_DATABASE_URL=

# Per-attempt provider timeout (seconds) and attempts per model before falling back.
GW_REQUEST_TIMEOUT=30
GW_MAX_ATTEMPTS=2

# Live provider keys (only with GW_PROVIDER_MODE=live). Providers without a key are skipped
# and their routes fall back to the next model.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Models, routes, team allow-lists and budgets live in config/gateway.yaml.
# GW_LIVE_TESTS=0
